{
  "name": "lutelingo-app",
  "type": "module",
  "private": true,
  "version": "1.2.0",
  "license": "AGPL-3.0-or-later",
  "author": "souljasec (https://github.com/souljasec)",
  "scripts": {
    "dev": "astro dev --host --port 4330",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "node --test 'test/*.test.ts'",
    "test:e2e": "node --test --test-concurrency=1 'test/e2e/*.e2e.ts'",
    "db:backup": "mkdir -p backups && wrangler d1 export DB --remote --output backups/db-$(date +%Y-%m-%d-%H%M).sql",
    "release": "npm test && npm run test:e2e && npm run db:backup && npm run db:migrate:remote && npm run deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    }
  }
}
