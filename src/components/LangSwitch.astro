---
import { LANGS } from '../lib/i18n.ts';
const { lang } = Astro.locals;
const back = Astro.url.pathname;
---

<nav class="langs" aria-label="Language">
  {
    Object.entries(LANGS).map(([code, name]) =>
      code === lang ? <strong>{name}</strong> : <a href={`/lang?to=${code}&back=${back}`} lang={code}>{name}</a>,
    )
  }
</nav>

<style>
  .langs { display: flex; gap: 1rem; justify-content: center; margin-top: 2rem; font-size: 0.9375rem; }
  .langs a, .langs strong { min-height: 44px; display: inline-flex; align-items: center; }
  .langs strong { color: var(--ink-mute); font-weight: 500; }
</style>
