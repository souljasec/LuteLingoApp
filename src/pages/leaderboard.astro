---
import { env } from 'cloudflare:workers';
import App from '../layouts/App.astro';
import Icon from '../components/Icon.astro';
import { leaderboard } from '../lib/xp.ts';

const { t } = Astro.locals;
const user = Astro.locals.user!;

// Students see their own classes; admins can open any class with ?class=ID.
const { results: classes } = await (user.role === 'admin'
  ? env.DB.prepare('SELECT id, name FROM classes ORDER BY name')
  : env.DB.prepare('SELECT c.id, c.name FROM classes c JOIN class_members m ON m.class_id = c.id WHERE m.user_id = ? ORDER BY c.name').bind(user.id)
).all<{ id: number; name: string }>();
const wanted = Number(Astro.url.searchParams.get('class'));
const current = classes.find((c) => c.id === wanted) ?? classes[0];
const rows = current ? await leaderboard(current.id) : [];
---

<App title={t('board.title')} back="/">
  {
    !current ? (
      <p class="muted">{t('board.noClass')}</p>
    ) : (
      <>
        {classes.length > 1 && (
          <nav class="chips" aria-label={t('admin.classes')}>
            {classes.map((c) => (
              <a href={`/leaderboard?class=${c.id}`} aria-current={c.id === current.id ? 'page' : undefined}>{c.name}</a>
            ))}
          </nav>
        )}
        <p class="eyebrow">{current.name} · {t('board.week')}</p>
        <ol class="board">
          {rows.map((r, i) => (
            <li class:list={['card', { me: r.id === user.id, top: i < 3 && r.xp > 0 }]}>
              <span class={`rank r${i + 1}`}>{i < 3 && r.xp > 0 ? <Icon name="trophy" size={18} /> : i + 1}</span>
              <span class="name">{r.name}{r.id === user.id && <em> · {t('board.you')}</em>}</span>
              <span class="xp">{r.xp} XP</span>
            </li>
          ))}
        </ol>
        <p class="hint">{t('board.resets')}</p>
      </>
    )
  }
</App>

<style>
  .chips { display: flex; gap: 0.4rem; overflow-x: auto; margin: 0 -1rem 1rem; padding: 0 1rem; }
  .chips a { flex: none; padding: 0.5rem 0.875rem; border: 1px solid var(--rule-strong); border-radius: var(--r); background: var(--surface); color: var(--ink-soft); text-decoration: none; font: 500 0.875rem/1 var(--font-display); }
  .chips a[aria-current='page'] { background: var(--accent); border-color: var(--accent); color: var(--paper); }
  .eyebrow { margin: 0.25rem 0 0.75rem; }
  .board { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .board li { display: flex; align-items: center; gap: 0.875rem; padding: 0.75rem 1rem; }
  .board li.me { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .rank { width: 2rem; height: 2rem; display: grid; place-items: center; border-radius: 50%; font: 700 0.9375rem/1 var(--font-display); color: var(--ink-mute); background: var(--paper-warm); flex: none; }
  .top .r1 { background: #e6cc86; color: var(--on-saffron); }
  .top .r2 { background: #dfe3e6; color: var(--on-saffron); }
  .top .r3 { background: #e9c3a4; color: var(--on-saffron); }
  .name { flex: 1; min-width: 0; font: 500 1.0625rem/1.3 var(--font-display); overflow-wrap: anywhere; }
  .name em { font-style: normal; color: var(--accent); }
  .xp { font: 700 1rem/1 var(--font-display); color: var(--accent); }
  .hint { margin-top: 1rem; text-align: center; }
</style>
