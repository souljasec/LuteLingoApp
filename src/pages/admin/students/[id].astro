---
import { env } from 'cloudflare:workers';
import App from '../../../layouts/App.astro';
import { fmtDate, student } from '../../../lib/admin.ts';
import { hashPassword, randomToken } from '../../../lib/crypto.ts';
import { streakFrom, weekStart } from '../../../lib/xp-dates.ts';
import { activeDays } from '../../../lib/xp.ts';

const { t, lang } = Astro.locals;
const me = Astro.locals.user!;
const id = Number(Astro.params.id);
if (!(await student(id))) return Astro.redirect('/admin/students');
const isMe = id === me.id;

let tempPassword = '';
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const action = f.get('action');
  if (action === 'reset') {
    // Shown once on this response, never stored in plain text. Old sessions are logged out.
    tempPassword = randomToken().replace(/[-_]/g, '').slice(0, 10);
    await env.DB.batch([
      env.DB.prepare('UPDATE users SET password_hash = ?, failed_logins = 0, locked_until = 0 WHERE id = ?').bind(await hashPassword(tempPassword), id),
      env.DB.prepare('DELETE FROM sessions WHERE user_id = ?').bind(id),
    ]);
  } else if (action === 'join') {
    // INSERT … SELECT: an unknown class id inserts nothing instead of failing the foreign key.
    await env.DB.prepare('INSERT OR IGNORE INTO class_members (class_id, user_id) SELECT id, ? FROM classes WHERE id = ?')
      .bind(id, Number(f.get('class')))
      .run();
  } else if (action === 'leave') {
    await env.DB.prepare('DELETE FROM class_members WHERE class_id = ? AND user_id = ?').bind(Number(f.get('class')), id).run();
  } else if (action === 'role' && !isMe) {
    // An admin can't demote themselves, so the school never ends up with no admin.
    await env.DB.prepare("UPDATE users SET role = CASE role WHEN 'admin' THEN 'student' ELSE 'admin' END WHERE id = ?").bind(id).run();
  } else if (action === 'delete' && !isMe) {
    await env.DB.prepare('DELETE FROM users WHERE id = ?').bind(id).run(); // cascades to all their data
    return Astro.redirect('/admin/students');
  }
  if (!tempPassword) return Astro.redirect(`/admin/students/${id}`);
}

const s = (await student(id))!;
// Only numbers about a student's learning, never what they read or saved.
const [classes, allClasses, activity] = await Promise.all([
  env.DB.prepare('SELECT c.id, c.name FROM classes c JOIN class_members m ON m.class_id = c.id WHERE m.user_id = ? ORDER BY c.name')
    .bind(id).all<{ id: number; name: string }>(),
  env.DB.prepare('SELECT id, name FROM classes ORDER BY name').all<{ id: number; name: string }>(),
  activeDays(id).all<{ day: string; xp: number }>(),
]);
const week = weekStart();
const thisWeek = activity.results.filter((a) => a.day >= week);
const streak = streakFrom(new Set(activity.results.map((a) => a.day)));
const xpWeek = thisWeek.reduce((n, a) => n + a.xp, 0);
const mine = new Set(classes.results.map((c) => c.id));
const joinable = allClasses.results.filter((c) => !mine.has(c.id));
---

<App title={s.name} back="/admin/students">
  <p class="email">{s.email}{s.role === 'admin' && ` · ${t('account.admin')}`}</p>

  {
    tempPassword && (
      <div class="temp" role="status">
        <p>{t('admin.tempPw')}</p>
        <p class="pw"><code>{tempPassword}</code></p>
      </div>
    )
  }

  <dl class="stats">
    <div><dt>{xpWeek}</dt><dd>{t('ins.xpWeek')}</dd></div>
    <div><dt>{thisWeek.length}</dt><dd>{t('admin.daysWeek')}</dd></div>
    <div><dt>{streak}</dt><dd>{t('xp.streak')}</dd></div>
    <div><dt>{s.finished}</dt><dd>{t('admin.finished')}</dd></div>
    <div><dt>{s.known}</dt><dd>{t('library.known')}</dd></div>
    <div><dt>{s.learning}</dt><dd>{t('library.learning')}</dd></div>
  </dl>
  <p class="hint">
    {t('admin.lastActive')}: {fmtDate(s.last_active_at, lang) ?? t('admin.never')} · {t('admin.joined')}: {fmtDate(s.created_at, lang)}
  </p>

  <h2>{t('admin.inClasses')}</h2>
  {classes.results.length === 0 && <p class="muted">{t('admin.noClass')}</p>}
  <ul class="chips">
    {
      classes.results.map((c) => (
        <li>
          <a href={`/admin/classes/${c.id}`}>{c.name}</a>
          <form method="post">
            <input type="hidden" name="class" value={c.id} />
            <button name="action" value="leave" aria-label={`${t('admin.remove')}: ${c.name}`}>✕</button>
          </form>
        </li>
      ))
    }
  </ul>
  {
    joinable.length > 0 && (
      <form method="post" class="row">
        <select name="class" aria-label={t('admin.addToClass')}>
          {joinable.map((c) => <option value={c.id}>{c.name}</option>)}
        </select>
        <button class="btn quiet" name="action" value="join">{t('admin.addToClass')}</button>
      </form>
    )
  }

  <section class="danger-zone">
    <form method="post" data-confirm={t('admin.resetConfirm')}>
      <button class="btn quiet block" name="action" value="reset">{t('admin.resetPw')}</button>
    </form>
    {
      !isMe && (
        <>
          <form method="post">
            <button class="btn quiet block" name="action" value="role">{s.role === 'admin' ? t('admin.removeAdmin') : t('admin.makeAdmin')}</button>
          </form>
          <form method="post" data-confirm={t('admin.deleteStudentConfirm')}>
            <button class="btn danger block" name="action" value="delete">{t('admin.deleteStudent')}</button>
          </form>
        </>
      )
    }
  </section>
</App>

<style>
  .email { color: var(--ink-mute); margin: 0 0 1rem; word-break: break-all; }
  .temp { border: 1px solid var(--accent); background: color-mix(in srgb, var(--accent) 8%, var(--paper)); border-radius: var(--r); padding: 0.75rem 1rem; margin-bottom: 1rem; }
  .temp p { margin: 0; }
  .pw code { font: 700 1.5rem/1.6 ui-monospace, monospace; letter-spacing: 0.08em; color: var(--accent); user-select: all; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; margin: 0 0 0.5rem; }
  .stats div { border: 1px solid var(--rule); border-radius: var(--r); padding: 0.75rem 0.5rem; text-align: center; background: var(--surface); }
  .stats dt { font: 700 1.75rem/1 var(--font-display); color: var(--accent); }
  .stats dd { margin: 0.35rem 0 0; font-size: 0.8125rem; color: var(--ink-mute); line-height: 1.3; }
  h2 { font-size: 1.0625rem; margin: 1.75rem 0 0.75rem; }
  .chips { list-style: none; padding: 0; margin: 0 0 0.75rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chips li { display: flex; align-items: center; border: 1px solid var(--rule-strong); border-radius: var(--r); background: var(--surface); }
  .chips a { padding: 0.5rem 0.25rem 0.5rem 0.75rem; color: var(--ink); text-decoration: none; }
  .chips button { width: 40px; height: 40px; border: 0; background: none; color: var(--ink-mute); cursor: pointer; }
  .row { display: flex; gap: 0.5rem; }
  .row select { flex: 1; min-width: 0; font: 400 1rem/1.4 var(--font-body); padding: 0.6rem 0.75rem; border: 1px solid var(--rule-strong); border-radius: var(--r); background: var(--surface); }
  .danger-zone { display: grid; gap: 0.75rem; margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((f) =>
    f.addEventListener('submit', (e) => {
      if (!confirm(f.dataset.confirm!)) e.preventDefault();
    }),
  );
</script>
