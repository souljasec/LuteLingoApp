---
import App from '../../../layouts/App.astro';
import AdminNav from '../../../components/AdminNav.astro';
import StudentList from '../../../components/StudentList.astro';
import { allStudents } from '../../../lib/admin.ts';

const { t } = Astro.locals;
const students = await allStudents();
---

<App title={t('tab.admin')}>
  <AdminNav />
  <p class="eyebrow">{students.length} {t('admin.members')}</p>
  {students.length === 0 ? <p class="muted">{t('admin.noStudents')}</p> : <StudentList students={students} />}
</App>
